{
  "manifest_version": 3,
  "name": "Obsidian Web Capture",
  "version": "0.3.1",
  "description": "Capture page text, selections and screenshots into an Obsidian vault.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "debugger",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Obsidian Web Capture",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
